# ClimaClue on a shared Caddy front door: served straight from files, no containers.
# Cloudflare -> Caddy (port 80, or 443 with an internal certificate) -> /srv/climaclue/public.
(climaclue_site) {
	# Compress text and the binary climate files (tiles and map colours shrink about 4x).
	encode {
		gzip
		match {
			header Content-Type text/*
			header Content-Type application/json*
			header Content-Type application/javascript*
			header Content-Type application/octet-stream*
			header Content-Type image/svg+xml*
		}
	}
	header X-Robots-Tag "noindex"
	header X-Content-Type-Options "nosniff"
	# ClimaClue's chat service (holds the API key; see climaclue-api.service).
	handle /api/* {
		reverse_proxy 127.0.0.1:8090
	}
	handle_path /squares/* {
		root * /srv/climaclue/public/squares
		header Cache-Control "public, max-age=86400"
		file_server
	}
	handle /assets/* {
		root * /srv/climaclue/public/site
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}
	handle {
		root * /srv/climaclue/public/site
		header Cache-Control "public, max-age=0, must-revalidate"
		try_files {path} {path}/index.html
		file_server
	}
	handle_errors {
		root * /srv/climaclue/public/site
		rewrite * /404.html
		file_server
	}
}
http://climaclue.com, http://www.climaclue.com {
	import climaclue_site
}
climaclue.com, www.climaclue.com {
	tls internal
	import climaclue_site
}
