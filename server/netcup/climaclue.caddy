# ClimaClue behind the shared Caddy on the Netcup server: static files plus one small API on 127.0.0.1:3100.
# Cloudflare (proxied DNS) -> Caddy -> /srv/climaclue/public. Same behaviour as the old server: Cloudflare ends public
# HTTPS; Caddy answers on port 80 and on 443 with an internal certificate, so no certificate has to be issued at cutover.
(climaclue_site) {
	# Compress text and the binary climate files (tiles and map colours shrink about 4x).
	encode {
		gzip
		match {
			header Content-Type text/*
			header Content-Type application/json*
			header Content-Type application/javascript*
			header Content-Type application/octet-stream*
			header Content-Type image/svg+xml*
		}
	}
	header X-Content-Type-Options "nosniff"
	# ClimaClue's chat service (holds the API key; see climaclue-api.service).
	handle /api/* {
		reverse_proxy 127.0.0.1:3100
	}
	handle_path /squares/* {
		root * /srv/climaclue/public/squares
		header Cache-Control "public, max-age=86400"
		file_server
	}
	handle /assets/* {
		root * /srv/climaclue/public/site
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}
	handle {
		root * /srv/climaclue/public/site
		header Cache-Control "public, max-age=0, must-revalidate"
		try_files {path} {path}/index.html
		file_server
	}
	handle_errors {
		root * /srv/climaclue/public/site
		rewrite * /404.html
		file_server
	}
}
http://climaclue.com, http://www.climaclue.com {
	import climaclue_site
}
climaclue.com, www.climaclue.com {
	tls internal
	import climaclue_site
}
