777777666666666666666666666666555443211000//.--,,,+**))'&%%$#""!  4444444444444444444444444454443221100///...--,,++*)))(&%%$#"!! 1111111111122222222222222221100////..---,,,,+**)))(''&%$#!! ...////////////////////////...---,,,+++***))((''&&&%$#"! ,,,,,,,,,,,,,,,,,,,,,,,,,++++++****))(((''&&%$$$###"!  ))))))))******))))))))))))(((((((''&&%%%$$#"!!!!!   '''''''''''''''''''&&''&&&&&%%%%%%$$#""!! $%%%%%%%%%%%%%$$$$$$$$$$$########"!! ##############""""""!!!!!!!!     !!!!!!!!!!!!!!!!    !            