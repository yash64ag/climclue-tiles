)))((''''&&&%%%%%$$$$$###""""!!!!!!   )(('''''&&&%%%$$$$$$####"""!!!!!!     ('''''&&&%%%%$$$$$####""""!!!!!     ''&&&&&&%%%%$$$$####""""!!!!!!    '&&&&%%%%%%$$$$####""""!!!!!!     &&&%%%%%%$$$$$####"""""!!!!!     &&%%%%%$$$$$$#####"""""!!!!!     &%%%%$$$$$$$$#####"""""!!!!!     %%%%%$$$$$$$#####""""""!!!!!!    %%%%%%$$$$$$$####""""""!!!!!!     &%%%%%$$$$$$#####"""""""!!!!!!     &&%%%%$$$$$$#####""""""!!!!!!!     &%%%%$$$$$$$#